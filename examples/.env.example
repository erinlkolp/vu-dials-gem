VU1_SERVER_ADDRESS=localhost
VU1_SERVER_PORT=5340
API_KEY=your-api-key-here
POLL_INTERVAL_SECONDS=2
YELLOW_THRESHOLD=60
RED_THRESHOLD=85
TEMP_YELLOW_C=70
TEMP_RED_C=85
# Override CPU temperature discovery only if the defaults don't find your sensor:
# CPU_TEMP_HWMON=coretemp
# CPU_TEMP_PATH=/sys/class/hwmon/hwmon8/temp1_input
LOG_LEVEL=INFO
